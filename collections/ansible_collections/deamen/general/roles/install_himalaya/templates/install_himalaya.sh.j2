#!/usr/bin/env bash
# {{ ansible_managed }}
# Install the latest himalaya release into ~/.local/bin of the user running this script
set -euo pipefail

himalaya="${HOME}/.local/bin/himalaya"

# Run the upstream installer so the release and its layout follow upstream, but judge the result by
# the installed binary: upstream install.sh can exit non-zero after installing it, for example on a
# broken final message. A failed download or extraction leaves no working binary and still fails
status=0
curl -fsSL {{ __himalaya_installer_url }} | PREFIX="${HOME}/.local" sh || status=$?

if ! "${himalaya}" --version; then
    echo "himalaya is not installed at ${himalaya}" >&2
    exit "$((status == 0 ? 1 : status))"
fi
if [ "${status}" -ne 0 ]; then
    echo "Warning: upstream install.sh exited with ${status}, but ${himalaya} works" >&2
fi
