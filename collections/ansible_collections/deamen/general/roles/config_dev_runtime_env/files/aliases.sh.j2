export CURRENT_USER={{ current_user | default("$(id -u -n)") }}
export PRJ_HOME={{ prj_home | default('$( [ "$(id -u -n)" = "root" ] && echo "/root" || echo "/home" )') }}
export PRJ_DIR="$( [ "${CURRENT_USER}" = "root" ] && echo "${PRJ_HOME}/Prj/" || echo "${PRJ_HOME}/${CURRENT_USER}/Prj/" )"

if [ -f "$HOME/.ansible_vault_pass.gpg" ] && [ -f /usr/local/bin/ansible_vault_pass_gpg.sh ]; then
  export ANSIBLE_VAULT_PASSWORD_FILE=/usr/local/bin/ansible_vault_pass_gpg.sh
fi

alias prj='cd ${PRJ_DIR}'
alias noproxy='export http_proxy="" && export HTTP_PROXY=${http_proxy} && export https_proxy="" && export HTTPS_PROXY=${https_proxy} && ftp_proxy=""'
alias gh_web_login='gh auth login --git-protocol https --hostname github.com --web'

# Prompt for the vault password only when no password file is configured
_ansible_vault_args() {
  [ -n "${ANSIBLE_VAULT_PASSWORD_FILE}" ] || echo "--ask-vault-pass"
}

ansiblev() {
  # shellcheck disable=SC2046
  ansible -e "@$HOME/.ansible_vault.yml" $(_ansible_vault_args) "$@"
}

ansible-playbookv() {
  # shellcheck disable=SC2046
  ansible-playbook -e "@$HOME/.ansible_vault.yml" $(_ansible_vault_args) "$@"
}

# pinentry-curses (gpg-agent.conf from deamen.gpg.config_gpg) reads GPG_TTY.
# Guarded with [ -t 0 ] because config_ansible_runtime_env sources this file from a
# non-interactive shell task, where tty prints "not a tty"
if [ -t 0 ]; then
  GPG_TTY=$(tty)
  export GPG_TTY
fi

# Prompt for the GPG passphrase now so gpg-agent caches the signing and decryption
# subkeys, e.g. before ansible_vault_pass_gpg.sh runs gpg --batch.
# A function rather than an alias because of the pipeline; uses the default key.
unlock_gpg() {
  # updatestartuptty points pinentry at this terminal when the agent was started from another one
  gpg-connect-agent updatestartuptty /bye >/dev/null &&
    echo | gpg --clearsign >/dev/null &&
    echo | gpg --encrypt --default-recipient-self | gpg --decrypt --quiet >/dev/null &&
    echo "gpg-agent unlocked"
}
