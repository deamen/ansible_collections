{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(./**)",
      "Write(./**)",
      "Bash(ansible-lint:*)",
      "Bash(yamllint:*)",
      "Bash(ansible-playbook --syntax-check:*)",
      "Bash(ansible-test sanity:*)",
      "Bash(pre-commit run:*)",
      "Bash(./helper_scripts/init_role.py:*)",
      "Bash(./helper_scripts/init_collection.py:*)",
      "Bash(./helper_scripts/init_molecule.py:*)"
    ],
    "deny": [
      "Read(./**/*vault_pass*)",
      "Read(./**/.ssh/**)",
      "Read(./**/*.pkey)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)"
    ]
  }
}
